+-- Value popup: MainStage calls controller_midi_out with the mapped parameter's
+-- name and value string whenever it sends feedback for a knob or fader.
+-- The popup is sent from the timer so fast moves only redraw the latest value.
+
+FADER_CCS = {105, 106, 107, 108, 109, 110, 111, 112, 113}
+KNOB_CCS = {91, 92, 94, 95, 96, 97, 102, 103, 104}
+PENDING_POPUP = nil
+POPUP_TIMER_ARMED = false
+ARMED_WAIT_COUNT = 0
+-- True right after a patch change: MainStage resends every mapped value then,
+-- which should refresh LAST_VALUES without popping up over the patch list
+SUPPRESS_POPUPS = false
+
+-- Last name/value MainStage reported per CC, so a touch can show it again
+LAST_VALUES = {}
+
+-- Touch NRPN (CC99 = 0, CC98 = control, CC6 = 127 touch / 0 release) -> control CC
+TOUCH_TO_CC = {
+	[28] = 105, [29] = 106, [30] = 107, [31] = 108, [33] = 109,	-- Faders 1-5
+	[34] = 110, [35] = 111, [36] = 112, [37] = 113,				-- Faders 6-9
+	[8] = 91, [9] = 92, [10] = 94, [11] = 95,					-- Knobs 1-4
+	[12] = 96, [13] = 97, [14] = 102, [15] = 103,				-- Knobs 5-8
+	[38] = 104,													-- Knob 9
+}
+NRPN_CONTROL = nil
+-- Controls currently touched: only these pop up on value changes, so changes
+-- made by other sources (mod wheel, automation, patch load) stay off screen
+TOUCHED = {}
+
+-- After the last control is released, the patch list is redrawn RESTORE_DELAY_MS
+-- later. MainStage keeps a single pending timer (a new settriggertimer replaces
+-- the previous one) and drops timers armed inside controller_timer_trigger, so
+-- the restore timer is always armed from the release itself
+RESTORE_DELAY_MS = 1000
+RESTORE_PENDING = false
+RESTORE_FULL_REDRAW = false	-- true = clear and redraw the whole list (blinks)
+LIST_RESTORE = nil		-- set by controller_select_patch: redraws the current list
+
+function ToAscii(text)
+	-- Keep printable ASCII only (dB / infinity symbols would break the SysEx)
+	return (string.gsub(tostring(text or ""), "[^\32-\126]", ""))
+end
+
+function ShowPopup(cc)
+	local last = LAST_VALUES[cc]
+	if last == nil then
+		return
+	end
+
+	PENDING_POPUP = SetCenterPage(last.page_type, last.name, 1, WHITE, last.value, 1, WHITE, last.hw_value)
+	-- Arm the timer only if it isn't already running: re-arming on every
+	-- move would keep postponing the redraw while the fader moves
+	if not POPUP_TIMER_ARMED then
+		POPUP_TIMER_ARMED = true
+		ARMED_WAIT_COUNT = 0
+		settriggertimer(20)
+	else
+		-- Watchdog: if MainStage dropped the timer, re-arm instead of waiting forever
+		ARMED_WAIT_COUNT = ARMED_WAIT_COUNT + 1
+		if ARMED_WAIT_COUNT > 40 then
+			ARMED_WAIT_COUNT = 0
+			settriggertimer(20)
+		end
+	end
+end
+
+function controller_midi_out(midiEvent, name, valueString, color)
+
+	if midiEvent[0] == 0xB0 and name == 'Unmapped' then
+		-- Control not used by this patch: forget its old value
+		LAST_VALUES[midiEvent[1]] = nil
+	elseif midiEvent[0] == 0xB0 and name ~= nil then
+		local page_type = nil
+		if table.contains(FADER_CCS, midiEvent[1]) then
+			page_type = 29
+		elseif table.contains(KNOB_CCS, midiEvent[1]) then
+			page_type = 28
+		end
+
+		if page_type ~= nil then
+			local value = valueString
+			if value == nil then
+				value = string.format("%d", midiEvent[2])
+			end
+			LAST_VALUES[midiEvent[1]] = {
+				page_type = page_type,
+				name = ToAscii(name),
+				value = ToAscii(value),
+				hw_value = math.max(0, math.min(127, math.floor(midiEvent[2] or 0))),
+			}
+			if not SUPPRESS_POPUPS then
+				if TOUCHED[midiEvent[1]] then
+					ShowPopup(midiEvent[1])
+				end
+			else
+				-- Watchdog for a dropped quiet-period timer
+				ARMED_WAIT_COUNT = ARMED_WAIT_COUNT + 1
+				if ARMED_WAIT_COUNT > 40 then
+					ARMED_WAIT_COUNT = 0
+					settriggertimer(20)
+				end
+			end
+		end
+	end
+
+	return nil
+
+end
+
+function controller_timer_trigger()
+
+	POPUP_TIMER_ARMED = false
+	ARMED_WAIT_COUNT = 0
+	if SUPPRESS_POPUPS then
+		-- End of the post-patch-change quiet period: drop the queued burst
+		SUPPRESS_POPUPS = false
+		PENDING_POPUP = nil
+		-- A control released during the quiet period still needs its restore
+		if not RESTORE_PENDING then
+			return
+		end
+	end
+
+	local msg = PENDING_POPUP
+	PENDING_POPUP = nil
+
+	if RESTORE_PENDING then
+		RESTORE_PENDING = false
+		if next(TOUCHED) == nil and LIST_RESTORE ~= nil then
+			msg = LIST_RESTORE()
+		end
+	end
+
+	if msg ~= nil then
+		return { midi = msg }
+	end
+
+end
+
